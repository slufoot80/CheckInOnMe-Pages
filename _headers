# Résumé PDFs can't carry a <meta robots> tag, so keep them out of search
# via header instead. The HTML résumé pages use meta noindex directly.
/*.pdf
  X-Robots-Tag: noindex, nofollow

/*.doc
  X-Robots-Tag: noindex, nofollow

# Private App Review demo video for Apple. Apple requires a direct file link
# (not YouTube/Vimeo), so it must be publicly fetchable — but it shows a real
# third-party phone number on screen, so keep it out of search results.
/safepulse-consent-demo.mp4
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=3600
